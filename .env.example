# Copy to .env (or .env.local for `next dev`) and fill in real values.
# Generate a secret with: openssl rand -base64 32
JWT_SECRET=

# Database Configuration
# Default: SQLite (file-based)
DATABASE_URL=file:./dev.db

# Opt-in: PostgreSQL
# Set DATABASE_URL to your PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@localhost:5432/opm?schema=public
# Or explicitly configure DATABASE_PROVIDER:
# DATABASE_PROVIDER=postgresql

# Vikunja import (see README: Importing an Existing Board)
VIKUNJA_URL=http://localhost:3456/api/v1
VIKUNJA_API_TOKEN=

# Cookie Security
# Defaults to true in production (requires HTTPS).
# Set COOKIE_SECURE=false only if accessing directly over plain HTTP on a local LAN (e.g. http://192.168.x.x:3000).
# COOKIE_SECURE=false
