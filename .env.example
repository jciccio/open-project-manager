# Copy to .env (or .env.local for `next dev`) and fill in real values.
# Generate a secret with: openssl rand -base64 32
JWT_SECRET=

# Database Configuration
# Default: SQLite (file-based)
DATABASE_URL=file:./dev.db

# Opt-in: PostgreSQL
# Set DATABASE_URL to your PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@localhost:5432/opm?schema=public
# Or explicitly configure DATABASE_PROVIDER:
# DATABASE_PROVIDER=postgresql
