generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects      Project[]
  labels        Label[]
  apiTokens     ApiToken[]
  assignedCards CardAssignee[]
}

model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?

  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  key         String   @default("OPM")
  description String?
  color       String   @default("#6366f1")
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  columns Column[]
  cards   Card[]
  labels  Label[]
}

model Column {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  order     Int      @default(0)
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards Card[]
}

model Card {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columnId    String
  column      Column    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  title       String
  description String?
  number      Int       @default(1)
  priority    String    @default("NONE")
  points      Int?
  owner       String?
  dueDate     DateTime?
  completedAt DateTime?
  isArchived  Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parentId    String?
  parent      Card?     @relation("CardParentChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children    Card[]    @relation("CardParentChildren")

  labels            CardLabel[]
  comments          Comment[]
  attachments       Attachment[]
  assignees         CardAssignee[]
  outgoingRelations CardRelation[] @relation("SourceCardRelations")
  incomingRelations CardRelation[] @relation("TargetCardRelations")

  @@unique([projectId, number])
  @@index([parentId])
}

model CardAssignee {
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([cardId, userId])
  @@index([userId])
}

model Attachment {
  id         String   @id @default(cuid())
  cardId     String
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  filename   String
  storageKey String
  url        String
  size       Int
  mimeType   String?
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([cardId])
}

model CardRelation {
  id           String   @id @default(cuid())
  sourceCardId String
  sourceCard   Card     @relation("SourceCardRelations", fields: [sourceCardId], references: [id], onDelete: Cascade)
  targetCardId String
  targetCard   Card     @relation("TargetCardRelations", fields: [targetCardId], references: [id], onDelete: Cascade)
  type         String   // BLOCKS | BLOCKED_BY | RELATES_TO
  createdAt    DateTime @default(now())

  @@unique([sourceCardId, targetCardId, type])
}

model Label {
  id        String      @id @default(cuid())
  projectId String?
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String      @default("#3b82f6")
  cards     CardLabel[]

  @@unique([name, projectId, userId])
}

model CardLabel {
  cardId  String
  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
}

model Comment {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author    String
  content   String
  createdAt DateTime @default(now())
}
