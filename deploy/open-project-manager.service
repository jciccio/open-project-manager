[Unit]
Description=Open Project Manager (Self-Hosted Project Management)
After=network.target

[Service]
Type=simple
# Create the user and give it the paths it writes as shown in docs/installation-guide.md (Method A)
User=opm
Group=opm

# Install outside /home: ProtectHome below makes /home read-only for this service.
# If you cloned somewhere else, change this path in WorkingDirectory, EnvironmentFile, ExecStart and ReadWritePaths.
WorkingDirectory=/opt/open-project-manager

# Values in .env override these two; set HOSTNAME=127.0.0.1 there when a reverse proxy runs on this host
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0
EnvironmentFile=/opt/open-project-manager/.env

# Execution command using the Next.js standalone bundle (lightweight, optimal for Raspberry Pi)
ExecStart=/usr/bin/node /opt/open-project-manager/.next/standalone/server.js

# Restart policy
Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=open-project-manager

# Security & Sandboxing hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/open-project-manager
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
