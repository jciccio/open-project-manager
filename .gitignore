# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# AI Assistants & Agent Tooling
/.agent
/.agents
/.claude
# ** so nested .claude dirs are also covered, not just the root one blocked above
**/.claude/settings.local.json
/.windsurf
/.cursor
/.cursorrules
/.copilot
/.openai
/.gemini
skills-lock.json
# Written by `next dev` itself (see src/server/lib/generate-agent-files.js in
# the `next` package) — regenerated locally by anyone who runs the dev server.
/AGENTS.md
/CLAUDE.md

# Local scratch data & snapshots (not opm_data, which is a Docker named
# volume, not a bind mount — nothing in this repo writes to ./data)
/data
*.tgz

# Environment Files & Password/Secret Credentials
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
id_rsa*
secrets.*

# SQLite & Database Data Files
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite-journal
dev.db

# Next.js Build Output & Cache
/.next/
/out/
/build
/coverage
/.vercel

# OS & Logs
.DS_Store
Thumbs.db
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts
/src/generated/prisma
